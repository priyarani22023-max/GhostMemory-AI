# Cloudflare Workers AI Credentials (Required for Cloud Deployment on Netlify)
# Obtain these from your Cloudflare Dashboard (dash.cloudflare.com):
# 1. CLOUDFLARE_ACCOUNT_ID: Found in your Cloudflare dashboard URL or Workers AI overview.
# 2. CLOUDFLARE_API_TOKEN: Generated in Cloudflare Dashboard > My Profile > API Tokens (with Workers AI Read/Edit permissions).
# 3. CLOUDFLARE_AI_MODEL: Cloudflare model catalog identifier (default: @cf/google/gemma-4-26b-a4b-it).

CLOUDFLARE_ACCOUNT_ID="YOUR_CLOUDFLARE_ACCOUNT_ID"
CLOUDFLARE_API_TOKEN="YOUR_CLOUDFLARE_API_TOKEN"
CLOUDFLARE_AI_MODEL="@cf/google/gemma-4-26b-a4b-it"

# Netlify / Local Server Port
PORT=3000
